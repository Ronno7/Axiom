@import url("Palette.uss");

/* Axiom UI theme. Shared palette; focused items invert Light/Void for a clear shape change. */

.damage-feedback {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: var(--axiom-light);
}

.screen .unity-label,
.screen .unity-base-field__label {
    color: var(--axiom-light);
}

.screen--dimmed {
    background-color: var(--axiom-void-72);
}

.screen--menu {
    align-items: flex-start;
    padding-left: 160px;
}

/* ---------- Panels ---------- */

.panel {
    width: 780px;
    padding: 44px 52px;
    background-color: var(--axiom-void-97);
    border-width: 2px;
    border-color: var(--axiom-light);
}

.panel--wide {
    width: 1180px;
}

.panel--bare {
    background-color: var(--axiom-transparent);
    border-width: 0;
    padding: 0;
    width: auto;
    align-items: flex-start;
}

/* The 3D title (MenuTitle camera -> MenuTitle.renderTexture, 4:1), set as the background by MainMenu. */
.game-title {
    width: 960px;
    height: 240px;
    margin-left: 10px;
    margin-bottom: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.screen .panel-title {
    font-size: 46px;
    letter-spacing: 14px;
    -unity-font-style: bold;
    margin-bottom: 32px;
    padding: 0;
}

.screen .section-title {
    font-size: 24px;
    letter-spacing: 8px;
    color: var(--axiom-muted);
    margin: 8px 0 16px 0;
    padding: 0;
}

.screen .hint {
    font-size: 20px;
    color: var(--axiom-muted);
    margin: 16px 0 8px 0;
    white-space: normal;
}

.screen .body-text {
    font-size: 24px;
    white-space: normal;
    margin-bottom: 14px;
    padding: 0;
}

/* ---------- Buttons ----------
   SlantButton draws its own leaning, chevron-pointed shape from the --slant-* properties. */

.screen .menu-button {
    height: 66px;
    min-width: 440px;
    margin: 8px 0;
    padding: 0 48px 0 40px;
    font-size: 28px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--axiom-light);
    background-color: var(--axiom-transparent);
    background-image: none;
    border-width: 0;
    --slant-fill: var(--axiom-void-55);
    --slant-stroke: var(--axiom-edge);
    --slant-stroke-width: 2;
    --slant-lean: 18;
    --slant-point: 22;
    transition-property: translate, color;
    transition-duration: 0.08s;
}

.screen .menu-button:hover {
    background-color: var(--axiom-transparent);
    --slant-stroke: var(--axiom-light);
}

.screen .menu-button:focus {
    background-color: var(--axiom-transparent);
    color: var(--axiom-void);
    --slant-fill: var(--axiom-light);
    --slant-stroke: var(--axiom-light);
    translate: 14px 0;
}

/* SlantButton aligns the warm tick with its drawn left edge; MenuLook can switch it off. */
.menu-button .focus-marker {
    display: none;
    position: absolute;
    left: -22px;
    top: 12px;
    bottom: 12px;
    width: 6px;
    background-color: var(--axiom-orange);
}

.menu-button:focus .focus-marker {
    display: flex;
}

.no-focus-marker .menu-button:focus .focus-marker {
    display: none;
}

.screen .menu-button:active {
    background-color: var(--axiom-transparent);
    --slant-fill: var(--axiom-text);
    --slant-stroke: var(--axiom-text);
}

/* The main call to action (PLAY) is a step larger than its neighbours. */
.screen .menu-button--primary {
    height: 78px;
    min-width: 480px;
    font-size: 34px;
}

/* ---------- Options (slider, toggle) ---------- */

.screen .option {
    margin: 10px 0;
    padding: 12px 16px;
    border-width: 2px;
    border-color: var(--axiom-transparent);
}

.screen .option--focused {
    border-color: var(--axiom-light);
}

.screen .option .unity-base-field__label {
    font-size: 26px;
    min-width: 360px;
}

.screen .unity-base-slider__tracker {
    background-color: var(--axiom-panel);
    border-color: var(--axiom-muted);
    border-radius: 0;
}

.screen .unity-base-slider__dragger {
    background-color: var(--axiom-light);
    border-color: var(--axiom-light);
    border-radius: 0;
    width: 18px;
    height: 28px;
    margin-top: -10px;
}

.screen .unity-toggle__checkmark {
    width: 30px;
    height: 30px;
    border-width: 2px;
    border-radius: 0;
    border-color: var(--axiom-light);
    background-color: var(--axiom-transparent);
    -unity-background-image-tint-color: var(--axiom-void);
}

.screen .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: var(--axiom-light);
}

/* ---------- Help ---------- */

.help-columns {
    flex-direction: row;
    margin-bottom: 20px;
}

.help-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 48px;
}

.help-column--controls {
    flex-grow: 1.3;
}

.key-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.screen .key {
    min-width: 230px;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 6px 10px;
    margin-right: 18px;
    border-width: 2px;
    border-color: var(--axiom-light);
    -unity-text-align: middle-center;
}

.screen .key-action {
    font-size: 24px;
    flex-shrink: 1;
    white-space: normal;
    padding: 0;
}

/* ---------- Results ---------- */

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: var(--axiom-edge);
    padding: 10px 0;
}

.screen .stat-name {
    font-size: 26px;
    letter-spacing: 4px;
    color: var(--axiom-muted);
    padding: 0;
}

.screen .stat-value {
    font-size: 30px;
    -unity-font-style: bold;
    padding: 0;
}

.results-buttons {
    margin-top: 28px;
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* HUD text sits over bright scenery; a dark halo keeps it readable. */
.hud .unity-label {
    text-shadow: 0 0 8px var(--axiom-void-95);
}

.screen .hud-readout {
    font-size: 36px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    padding: 0;
}

.hud-time {
    position: absolute;
    left: 56px;
    top: 40px;
}

.hud-targets {
    position: absolute;
    right: 56px;
    top: 40px;
}

/* Tutorial only: rings flown through, under the targets. */
.hud-rings {
    display: none;
    position: absolute;
    right: 56px;
    top: 92px;
}

.screen .hud-rings {
    font-size: 22px;
    letter-spacing: 6px;
    color: var(--axiom-text);
}

.throttle {
    position: absolute;
    left: 56px;
    bottom: 48px;
    width: 460px;
}

/* The ship's own state, above the throttle: the left of the screen is the ship, the right its weapons. */
.shield {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.screen .shield-caption {
    width: 128px;
}

.screen .shield--low .shield-caption {
    color: var(--axiom-ember);
}

.shield-segments {
    flex-direction: row;
}

.screen .shield-note {
    margin-left: 12px;
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--axiom-cyan);
}

.screen .hud-caption {
    font-size: 20px;
    letter-spacing: 6px;
    color: var(--axiom-text);
    padding: 0;
}

.throttle-track {
    height: 18px;
    margin: 10px 0;
    border-width: 2px;
    border-color: var(--axiom-light);
}

.throttle-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
    background-color: var(--axiom-muted);
}

.throttle-cruise {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 2px;
    margin-left: -1px;
    background-color: var(--axiom-edge);
}

.throttle-setpoint {
    position: absolute;
    top: -10px;
    bottom: -10px;
    width: 8px;
    margin-left: -4px;
    background-color: var(--axiom-light);
    border-width: 2px;
    border-color: var(--axiom-void);
}

/* Entry: a readout's rule traces out before its text types in (InstrumentBuild). */
.instrument-build-rule {
    position: absolute;
    height: 2px;
    background-color: var(--axiom-cyan);
}

/* The track is the lever's travel in eight segments, like the cockpit's eight lights. */
.throttle-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--axiom-edge);
}

.throttle-tick--gate {
    top: -6px;
    bottom: -6px;
    width: 2px;
    margin-left: -1px;
    background-color: var(--axiom-text);
}

.throttle-boost-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    background-color: var(--axiom-panel);
}

.throttle--boosting .throttle-boost-zone {
    background-color: var(--axiom-light-50);
}

.screen .throttle-boost-label {
    position: absolute;
    bottom: 22px;
    right: 0;
    font-size: 14px;
    letter-spacing: 3px;
    padding: 0;
    margin: 0;
    color: var(--axiom-muted);
}

.throttle-reserve {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.screen .throttle-reserve-caption,
.screen .throttle-reserve-state {
    font-size: 14px;
    letter-spacing: 3px;
    padding: 0;
    margin: 0;
    color: var(--axiom-muted);
}

.screen .throttle-reserve-state {
    width: 130px;
    -unity-text-align: middle-right;
}

.throttle-reserve-track {
    flex-grow: 1;
    height: 4px;
    margin: 0 12px;
    background-color: var(--axiom-structure);
}

.throttle-reserve-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: var(--axiom-muted);
}

.screen .throttle--boost-ready .throttle-reserve-state,
.screen .throttle--boosting .throttle-reserve-state {
    color: var(--axiom-light);
}

.throttle--boost-ready .throttle-reserve-fill,
.throttle--boosting .throttle-reserve-fill {
    background-color: var(--axiom-light);
}

.screen .throttle-speed {
    font-size: 26px;
}

/* Throttle guidance (inside a ThrottleZone). Blue marks player guidance, like the
   shield segments, reticles, and floor cues. */
.throttle-band {
    position: absolute;
    top: -4px;
    bottom: -4px;
    background-color: var(--axiom-cyan-45);
    border-width: 0 2px;
    border-color: var(--axiom-cyan);
}

.throttle-readouts {
    flex-direction: row;
    justify-content: space-between;
}

.screen .throttle-hint {
    font-size: 26px;
    margin-left: 24px;
    color: var(--axiom-cyan);
}

.screen .throttle--guided .hud-caption {
    color: var(--axiom-cyan);
}

.screen .throttle--in-band .throttle-hint {
    color: var(--axiom-light);
}

/* Controller status (bottom right). Warnings invert so they read even without the buzzer. */
.hud-controller {
    position: absolute;
    right: 56px;
    bottom: 48px;
    padding: 4px 10px;
}

/* A stable setup, so a quiet line: the brightness is for the target, the instruction and what just changed. */
.screen .hud-controller {
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: normal;
    color: var(--axiom-muted);
}

.screen .hud-controller--warning {
    font-size: 22px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: var(--axiom-void);
    background-color: var(--axiom-light);
    text-shadow: 0 0 0 var(--axiom-transparent);
}

/* Collision warning (bottom centre, clear of the flight path). Pulses in time with the beeps. */
.hud-proximity {
    display: none;
    position: absolute;
    bottom: 48px;
    left: 50%;
    translate: -50% 0;
    padding: 4px 14px;
}

.screen .hud-proximity {
    font-size: 26px;
    letter-spacing: 8px;
    color: var(--axiom-light);
}

.screen .hud-proximity--pulse {
    color: var(--axiom-void);
    background-color: var(--axiom-light);
    text-shadow: 0 0 0 var(--axiom-transparent);
}

.screen .pause-notice {
    border-left-width: 4px;
    border-color: var(--axiom-cyan);
    padding-left: 14px;
    margin-bottom: 20px;
}

/* ---------- Controller calibration ---------- */

.calibration-instruction {
    min-height: 64px;
}

.calibration-live {
    flex-direction: row;
    align-items: flex-start;
    margin: 12px 0 8px 0;
}

.calibration-stick {
    width: 200px;
    height: 200px;
    margin-right: 48px;
    border-width: 2px;
    border-color: var(--axiom-light);
}

.calibration-cross {
    position: absolute;
    background-color: var(--axiom-edge);
}

.calibration-cross--h {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
}

.calibration-cross--v {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
}

.calibration-stick-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    border-radius: 9px;
    background-color: var(--axiom-cyan);
}

.calibration-throttle {
    flex-grow: 1;
}

.calibration-throttle-track {
    width: 100%;
    height: 24px;
}

.calibration-buttons {
    flex-direction: row;
    margin-top: 16px;
}

.calibration-buttons .menu-button {
    min-width: 300px;
    margin-right: 16px;
}

.options-calibrate {
    margin-top: 16px;
}

/* ---------- Main menu decoration (MenuLook toggles and tunes these) ---------- */

.scrim {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: url("Textures/ScrimGradient.png");
}

.frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.35;
}

.frame__corner {
    position: absolute;
    left: 40px;
    top: 40px;
    width: 36px;
    height: 36px;
    border-color: var(--axiom-light);
    border-left-width: 2px;
    border-top-width: 2px;
}

.frame__corner--right {
    left: auto;
    right: 40px;
    border-left-width: 0;
    border-right-width: 2px;
}

.frame__corner--bottom {
    top: auto;
    bottom: 40px;
    border-top-width: 0;
    border-bottom-width: 2px;
}

/* The status line starts on the menu column's grid line (x = 160, the QUIT button's edge). */
.menu-footer {
    position: absolute;
    left: 160px;
    right: 96px;
    bottom: 52px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.status-line,
.key-hints {
    flex-direction: row;
    align-items: center;
}

/* The authored opening keeps the same frame/status while menu navigation gives way to flight. */
.opening-in-flight #key-hints { visibility: hidden; }
.opening-in-flight #menu-footer { left: 56px; right: 56px; }

.status-led {
    width: 7px;
    height: 7px;
    margin-right: 12px;
    background-color: var(--axiom-light);
}

.status-led--offline {
    background-color: var(--axiom-ember);
}

.micro {
    font-size: 14px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: var(--axiom-muted);
    margin: 0 14px 0 0;
    padding: 0;
}

.micro--ink {
    color: var(--axiom-light);
}

.keycap {
    border-width: 1px;
    border-color: var(--axiom-light-50);
    border-radius: 3px;
    padding: 3px 4px 3px 8px;
    margin-right: 10px;
}

.key-verb {
    margin-right: 30px;
}

.roll-bar {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 6%;
    translate: 0 -50%;
    background-image: url("Textures/RollBar.png");
    opacity: 0.08;
}

/* The weapons panel (WeaponsPanel.uxml), laid out like a stores page. */
.weapons-layer,
.target-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.weapons-panel {
    position: absolute;
    right: 56px;
    bottom: 92px;
    width: 340px;
    padding: 10px 14px;
    background-color: var(--axiom-void-85);
    border-left-width: 2px;
    border-left-color: var(--axiom-cyan);
}

.weapons-panel-edge {
    position: absolute;
    left: -2px;
    top: 0;
    bottom: 0;
    width: 2px;
    display: none;
    background-color: var(--axiom-cyan);
    transform-origin: 0 100%;
}

.arm-bar {
    height: 34px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.arm-label {
    font-size: 22px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    padding: 0 8px;
}

.store-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
}

.store-bracket {
    width: 18px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--axiom-light);
    padding: 0;
}

.store-name-box {
    width: 52px;
}

.store-name {
    font-size: 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.store-value-box {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.store-bank {
    flex-direction: row;
    align-items: center;
}

.store-pip {
    width: 26px;
    height: 12px;
    margin-right: 4px;
    border-width: 1px;
}

.store-value {
    font-size: 18px;
    letter-spacing: 1px;
    padding: 0;
}

.store-count {
    margin-left: 6px;
}

/* Holds its line when empty, so the panel never changes height. */
.weapons-status {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--axiom-cyan);
    padding: 2px 0 0 0;
    margin-top: 4px;
    min-height: 20px;
}

/* The SAFE mark and target brackets, placed each frame by TargetMarkers. */
.safe-mark {
    position: absolute;
    width: 58px;
    height: 58px;
}

.safe-word {
    position: absolute;
    font-size: 20px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    padding: 0 6px;
    background-color: var(--axiom-void-78);
}

.target-marker {
    position: absolute;
}

.target-corner {
    position: absolute;
    width: 12px;
    height: 12px;
}

.target-corner--left {
    left: 0;
    border-left-width: 2px;
}

.target-corner--right {
    right: 0;
    border-right-width: 2px;
}

.target-corner--top {
    top: 0;
    border-top-width: 2px;
}

.target-corner--bottom {
    bottom: 0;
    border-bottom-width: 2px;
}

.target-number {
    position: absolute;
    width: 120px;
    font-size: 13px;
    -unity-font-style: bold;
}
