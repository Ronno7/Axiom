<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Opening.uss" />
    <ui:VisualElement name="opening-overlay" picking-mode="Ignore">
        <ui:VisualElement name="opening-choices" class="opening-card">
            <ui:Label text="ENTRY SEQUENCE / PLAYTEST" class="opening-micro" />
            <ui:Toggle name="watched-reveal" label="Watch ship completion" />
            <ui:Toggle name="reduce-motion" label="Reduce animation" />
            <ui:Button name="replay-training" text="REPLAY TRAINING" />
            <ui:Button name="scored-entry" text="SCORED RUN" />
            <ui:Label name="menu-arm" class="opening-micro" />
        </ui:VisualElement>
        <ui:VisualElement name="opening-hud" picking-mode="Ignore">
            <ui:VisualElement name="opening-address" picking-mode="Ignore">
                <ui:Label name="address-caption" text="GRID / ADMISSION" class="opening-micro" />
                <ui:Label name="address-text" class="opening-heading" />
                <ui:Label name="address-help" class="opening-help" />
            </ui:VisualElement>
            <ui:VisualElement name="opening-instruments" class="opening-card" picking-mode="Ignore">
                <ui:Label name="opening-speed" class="opening-heading" />
                <ui:VisualElement name="speed-track"><ui:VisualElement name="speed-fill" /></ui:VisualElement>
                <ui:Label name="opening-arm" />
                <ui:Label name="opening-score" class="opening-micro" />
                <ui:Label name="opening-weapons" class="opening-micro" />
            </ui:VisualElement>
            <ui:Label name="opening-console" picking-mode="Ignore" />
            <ui:Label name="opening-hints" text="ESC / MENU   PAUSE       TAB   SKIP TRAINING" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="opening-pause" class="opening-modal">
            <ui:Label name="opening-pause-text" class="opening-heading" />
            <ui:Label name="opening-pause-arm" class="opening-help" />
            <ui:Button name="opening-resume" text="RESUME" />
            <ui:Button name="opening-keyboard" text="CONTINUE WITH KEYBOARD" />
            <ui:Button name="opening-controller" text="USE CONNECTED CONTROLLER" />
            <ui:Button name="opening-back" text="RETURN TO MENU" />
        </ui:VisualElement>
        <ui:VisualElement name="opening-finish" class="opening-modal">
            <ui:Label text="SECTOR COMPLETE" class="opening-heading" />
            <ui:Label name="opening-final-score" class="opening-help" />
            <ui:Label text="Opening playtest ends here. Arena handoff follows in the next pass." class="opening-micro" />
            <ui:Button name="opening-again" text="RUN AGAIN" />
            <ui:Button name="opening-finish-menu" text="RETURN TO MENU" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
