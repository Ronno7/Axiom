# Shared editor settings; most IDEs (Rider, Visual Studio, VS Code) read this file.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,shader,hlsl,cginc,py,ino}]
indent_style = space
indent_size = 4

[*.{uxml,uss,json,asmdef,md,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 120
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline
dotnet_sort_system_directives_first = true
