# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
/Builds/
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE solution files (Unity regenerates them)
*.slnx

# Blender autosave/backups
*.blend1
*.blend2

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Internal development notes and assistant guidance (local only)
DevNotes/
AGENTS.md
.claude/

# Python bytecode from ArtSource and DevNotes tools
__pycache__/
*.pyc

# Local visual research library; separate from authored game assets
/Axiom/ArtSource/References/

# Local tool configuration
/.mcp.json

# Technical guides are retired for now and stay local
/Axiom/Docs/*.md
!/Axiom/Docs/ART_PALETTE.md
/Axiom/ArtSource/Ships/SweptDart/docs/TECHNICAL_NOTES.md

# Historical art is kept locally
/Axiom/ArtSource/Archive/

# Ship: only the current import package and the showcase are public. Blender sources stay local.
/AxiomPlayerShip.blend
/Axiom/ArtSource/Ships/SweptDart/archive/
/Axiom/ArtSource/Ships/SweptDart/references/
/Axiom/ArtSource/Ships/SweptDart/reviews/v13/*
!/Axiom/ArtSource/Ships/SweptDart/reviews/v13/presentation/
/Axiom/ArtSource/Ships/SweptDart/reviews/v13/presentation/*
!/Axiom/ArtSource/Ships/SweptDart/reviews/v13/presentation/ship-*.png
!/Axiom/ArtSource/Ships/SweptDart/reviews/v13/presentation/ship-sheet.jpg
!/Axiom/ArtSource/Ships/SweptDart/reviews/v13/presentation/sequence-sheet.jpg
!/Axiom/ArtSource/Ships/SweptDart/reviews/v13/presentation/sequence-*.mp4
/Axiom/ArtSource/Ships/SweptDart/reviews/v14/*
!/Axiom/ArtSource/Ships/SweptDart/reviews/v14/export/
/Axiom/ArtSource/Ships/SweptDart/reviews/v14/export/*.blend
!/Axiom/ArtSource/Ships/SweptDart/reviews/v14/qa/
/Axiom/ArtSource/Ships/SweptDart/reviews/v14/qa/*
!/Axiom/ArtSource/Ships/SweptDart/reviews/v14/qa/comparison.jpg
!/Axiom/ArtSource/Ships/SweptDart/reviews/v14/qa/sequence-sheet.jpg
!/Axiom/ArtSource/Ships/SweptDart/reviews/v14/qa/shield-sheet.jpg
!/Axiom/ArtSource/Ships/SweptDart/reviews/v14/qa/runtime-sequence.mp4
